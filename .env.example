# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in what you have.
# Every setting is optional: with an empty file the agent still runs end to end
# using deterministic statistics and template narrative instead of the LLM.
# ---------------------------------------------------------------------------

# ---------- Main LLM configuration ---------------------------------------
# Which provider to call first. Supported values:
#   groq        - free, preferred default (openai/gpt-oss-120b)
#   gemini      - Google Gemini (free tier)
#   openrouter  - OpenRouter aggregator
#   openai      - OpenAI (paid)
#   anthropic   - Anthropic Claude (paid)
# Leave empty to auto-detect from the keys you have set and the legacy MODEL id.
LLM_PROVIDER=groq

# Model id for the chosen provider. May also carry a provider prefix such as
# `groq:openai/gpt-oss-120b` or `gemini:gemini-2.5-flash`, in which case the
# prefix wins over LLM_PROVIDER. Leave empty to use the provider's default.
LLM_MODEL=openai/gpt-oss-120b

# If "on" the pipeline tries the next free provider with a configured key when
# the primary one is rate-limited, unavailable, or has no key set. Set to "off"
# to pin the chosen provider.
LLM_FALLBACK_ENABLED=on

# ---------- Groq (free, preferred default) --------------------------------
# Keys: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# ---------- Google Gemini (free tier) -------------------------------------
# Keys: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---------- OpenRouter ----------------------------------------------------
# Keys: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Pin a specific model, e.g. openrouter/auto or any model id OpenRouter exposes.
OPENROUTER_MODEL=

# ---------- Existing providers --------------------------------------------
# Anthropic keys: https://console.anthropic.com/
ANTHROPIC_API_KEY=
# OpenAI keys:    https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Legacy model id, still read so existing .env files keep working. The id
# picks the vendor when LLM_PROVIDER / LLM_MODEL are unset: `claude-*` goes to
# Anthropic, `gpt-*` to OpenAI.
#   claude-opus-5    - best quality (default)
#   claude-sonnet-5  - faster and cheaper
#   gpt-5            - OpenAI; needs OPENAI_API_KEY
MODEL=claude-opus-5

# ---------- Research & output --------------------------------------------
# Web research. "on" uses DuckDuckGo (no API key needed) to gather policy and
# macro context with citations. "off" relies only on the local policy file.
WEB_RESEARCH=on

# How many search results per research question.
SEARCH_RESULTS_PER_QUERY=6

# How many of the best pages to actually download and read per research theme.
PAGES_TO_READ=3

# Report output language: en | ru | uz
REPORT_LANGUAGE=en

# Where reports, figures and run logs are written.
OUTPUT_DIR=outputs

# How many rows to hold in memory at once. A folder of quarterly dumps can run to
# millions of adverts; above this budget the rows are thinned evenly across the
# data and the report says so. 0 reads every row (needs plenty of RAM).
MAX_ROWS=400000

# Som per US dollar, used to put listings advertised in som and in dollar-linked
# "у.е." onto one currency. Set this to the rate that applied when the data was
# collected, or reruns of an old file will be priced at today's rate.
UZS_PER_USD=12650

# Folder of archived OLX .db dumps used for the quarterly price history. Leave
# empty to run without a history section. The folder is read one level only, so
# point it at the folder holding the .db files, not a parent of it.
OLX_ARCHIVE=
