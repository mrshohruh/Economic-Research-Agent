# ---------------------------------------------------------------------------
# .env.example - sozlamalar namunasi. `.env` ga nusxalab, kerakli qiymatlarni
# to'ldiring. Hamma sozlama ixtiyoriy: kalit berilmasa, hisobot shablon
# asosida tayyorlanadi.
# ---------------------------------------------------------------------------

# ---------- Asosiy model sozlamalari --------------------------------------
# Qaysi provayderdan foydalanish: anthropic | openai | groq | gemini | openrouter
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
LLM_FALLBACK_ENABLED=on

# ---------- Provayder kalitlari (bittasini to'ldiring) --------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# ---------- Qo'shimcha sozlamalar -----------------------------------------
# Natija papkasi
OUTPUT_DIR=outputs

# Veb-tahlilni yoqish/o'chirish
WEB_RESEARCH=on

# USD/UZS kursi (yig'ish paytidagi kurs)
UZS_PER_USD=12650

# Tarixiy OLX .db fayllari papkasi (ixtiyoriy)
OLX_ARCHIVE=
