# Optional: enables LLM-backed narrative writing, hypothesis reasoning, and query generation.
# If left empty, the system falls back to deterministic, template-based text generation
# so the full pipeline still runs end-to-end without any API key.
ANTHROPIC_API_KEY=

# Optional model override
ANTHROPIC_MODEL=claude-sonnet-5

# Web research provider. "duckduckgo" requires no key. Set to "none" to disable web research.
SEARCH_PROVIDER=duckduckgo
